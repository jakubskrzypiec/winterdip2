# Wymuszenie HTTPS i jednego adresu (bez www) na hostingu OVH
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://winterdip.pl/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.winterdip\.pl$ [NC]
RewriteRule ^(.*)$ https://winterdip.pl/$1 [R=301,L]

# panel /admin: dane, konfiguracja i biblioteka niedostępne z przeglądarki
RewriteRule ^admin/(data/|lib\.php|config\.php) - [F,L]
Options -Indexes

# HTML, CSS i JS zawsze sprawdzane na nowo (moduły JS importują się bez numeru wersji,
# więc bez tego telefon mógłby trzymać starą wersję; serwer odpowiada wtedy szybkim 304)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
